# ─────────────────────────────────────────────────────────────────────
# CivicFix — Backend Environment Variables
# Copy to backend/.env for local dev. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-long-random-secret

# Database — pick ONE mode:
# LOCAL DEV (SQLite, default when DATABASE_URL is unset):
# DATABASE_URL=          # leave blank → uses local civicfix.db

# PRODUCTION (Supabase PostgreSQL — set this on Render):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Port (Render sets this automatically)
PORT=5000

# Allowed frontend origin for CORS (no trailing slash)
# LOCAL DEV:
ALLOWED_ORIGIN=http://localhost:5173
# PRODUCTION (your Vercel deployment URL):
# ALLOWED_ORIGIN=https://civicfix.vercel.app

# Optional: set to "production" in Render
FLASK_ENV=development

# ─────────────────────────────────────────────────────────────────────
# Frontend (Vite) — set in Vercel dashboard, NOT here
# ─────────────────────────────────────────────────────────────────────
# VITE_API_URL=https://your-render-backend.onrender.com
